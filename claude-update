#!/usr/bin/env bash
# claude-update — 执行 claude update 并打印 CHANGELOG 中本次更新覆盖的版本说明
set -euo pipefail

CHANGELOG_URL="${CLAUDE_UPDATE_CHANGELOG_URL:-https://raw.githubusercontent.com/anthropics/claude-code/main/CHANGELOG.md}"

usage() {
  cat <<'EOF'
用法: claude-update [选项]

执行 `claude update`，然后展示 CHANGELOG 中 (旧版本, 新版本] 的更新说明。
默认进入「逐版本浏览」模式：每个版本一个独立页面，可单独滚动，
按键在版本之间切换。

逐版本浏览快捷键（基于 less 多文件模式）:
  :n / Space      下一版本
  :p              上一版本
  ↑ ↓ PgUp PgDn   当前版本内滚动
  g / G           跳到首/末行
  /pattern        搜索
  q               退出

选项:
  -c, --combined   把所有版本合并到一页里滚动（旧行为）
  -P, --no-pager   直接打印全部，不进入交互
  -h, --help       显示本帮助

环境变量:
  CLAUDE_UPDATE_CHANGELOG_URL   覆盖 CHANGELOG 来源
  CLAUDE_UPDATE_PAGER / PAGER   --combined 模式下的 pager（默认 "less -RFX"）
EOF
}

NO_PAGER=0
COMBINED=0
for arg in "$@"; do
  case "$arg" in
    -P|--no-pager) NO_PAGER=1 ;;
    -c|--combined) COMBINED=1 ;;
    -h|--help)     usage; exit 0 ;;
    *) printf 'claude-update: 未知参数: %s\n\n' "$arg" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'
  GREEN=$'\033[0;32m'; CYAN=$'\033[0;36m'; YELLOW=$'\033[0;33m'; MAGENTA=$'\033[0;35m'
  RESET=$'\033[0m'
else
  BOLD=""; DIM=""; GREEN=""; CYAN=""; YELLOW=""; MAGENTA=""; RESET=""
fi

die() { printf '%sclaude-update: %s%s\n' "$YELLOW" "$*" "$RESET" >&2; exit 1; }

command -v claude >/dev/null 2>&1 || die "未找到 claude CLI，请先安装 Claude Code"
command -v curl   >/dev/null 2>&1 || die "未找到 curl"

current_version() {
  claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true
}

old_version="$(current_version)"
printf '%s当前版本：%s%s%s\n' "$CYAN" "$BOLD" "${old_version:-未安装}" "$RESET"

printf '%s▶ 执行 claude update ...%s\n' "$CYAN" "$RESET"
update_output="$(claude update 2>&1)" || {
  printf '%s\n' "$update_output"
  die "claude update 执行失败"
}
printf '%s%s%s\n' "$DIM" "$update_output" "$RESET"

new_version="$(current_version)"
printf '%s更新后版本：%s%s%s\n' "$CYAN" "$BOLD" "${new_version:-未知}" "$RESET"

if [[ -z "$new_version" ]]; then
  die "无法获取更新后的版本号，跳过 CHANGELOG 展示"
fi

if [[ -n "$old_version" && "$old_version" == "$new_version" ]]; then
  printf '%s✓ 已是最新版本，仍展示该版本的 CHANGELOG%s\n' "$GREEN" "$RESET"
fi

printf '%s▶ 拉取 CHANGELOG ...%s\n' "$CYAN" "$RESET"
changelog="$(curl -fsSL --max-time 15 "$CHANGELOG_URL")" || die "无法获取 CHANGELOG: $CHANGELOG_URL"

# 切出 (old_version, new_version] 区间。
# 用 semver 数值比较，避免 old 不在 CHANGELOG 中时一直打到底。
section="$(printf '%s\n' "$changelog" | awk -v new="$new_version" -v old="${old_version:-0.0.0}" '
  function ver_num(v,    a) {
    if (split(v, a, ".") != 3) return -1
    return a[1]*1000000 + a[2]*1000 + a[3]
  }
  BEGIN { new_n = ver_num(new); old_n = ver_num(old) }
  /^## / {
    v = $2
    n = ver_num(v)
    if (n < 0)            { next }      # 不像版本号的标题，忽略
    if (n == new_n)       { printing = 1 }
    else if (n <= old_n)  { exit }      # 已经回到旧版本或更早，停
  }
  printing { print }
')"

if [[ -z "${section// /}" ]]; then
  printf '%s未在 CHANGELOG 中找到版本 %s 的说明%s\n' "$YELLOW" "$new_version" "$RESET"
  exit 0
fi

# 高亮函数：## 版本号 标红，- 列表项前缀加色。
highlight() {
  awk -v BOLD="$BOLD" -v MAGENTA="$MAGENTA" -v GREEN="$GREEN" -v RESET="$RESET" '
    /^## / { printf "%s%s%s%s\n", BOLD, MAGENTA, $0, RESET; next }
    /^- /  { sub(/^- /, GREEN "• " RESET); print; next }
    { print }
  '
}

want_interactive() {
  [[ "$NO_PAGER" == "0" && -t 1 ]]
}

if want_interactive && [[ "$COMBINED" == "0" ]] && command -v less >/dev/null 2>&1; then
  # 逐版本浏览：把每个版本切到独立临时文件，交给 less 多文件模式。
  tmpdir="$(mktemp -d -t claude-update.XXXXXX)"
  trap 'rm -rf "$tmpdir"' EXIT

  # 切片：每个版本一个文件，文件名就是版本号（less prompt %f 显示更干净）。
  # 按 awk 的输出顺序回传到 version_files；less 按命令行参数顺序遍历，无需字典序。
  # 用 while read 循环替代 mapfile 以兼容 bash 3.2（macOS 系统 bash）。
  version_files=()
  while IFS= read -r f; do version_files+=("$f"); done < <(
    printf '%s\n' "$section" | awk -v dir="$tmpdir" '
      /^## / {
        if (out) close(out)
        out = sprintf("%s/%s", dir, $2)
        print out
      }
      out { print > out }
    '
  )

  for f in "${version_files[@]}"; do
    highlight < "$f" > "$f.colored" && mv "$f.colored" "$f"
  done

  # less prompt：%f 当前文件名（即版本号），%i 当前序号，%m 总数。
  prompt="Claude Code %f   (%i/%m)   :n 下一版  :p 上一版  q 退出"
  less -R --prompt="$prompt" "${version_files[@]}"
else
  # --combined / --no-pager / 非 TTY / 没有 less：合并打印，可选走 pager。
  pager_cmd=""
  if want_interactive; then
    pager_cmd="${CLAUDE_UPDATE_PAGER:-${PAGER:-less -RFX}}"
  fi
  {
    printf '\n%s%s━━━ 更新内容 ━━━%s\n\n' "$BOLD" "$MAGENTA" "$RESET"
    printf '%s\n' "$section" | highlight
  } | if [[ -n "$pager_cmd" ]]; then eval "$pager_cmd"; else cat; fi
fi
