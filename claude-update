#!/usr/bin/env bash
# claude-update — run `claude update` and pretty-print the matching CHANGELOG sections.
# https://github.com/harrisliangsu/claude-update
set -euo pipefail

CLAUDE_UPDATE_VERSION="0.2.0"

CHANGELOG_URL="${CLAUDE_UPDATE_CHANGELOG_URL:-https://raw.githubusercontent.com/anthropics/claude-code/main/CHANGELOG.md}"

usage() {
  cat <<'EOF'
Usage: claude-update [OPTIONS]

Run `claude update`, then show the CHANGELOG. The default slice is
(old_version, new_version]; if you're already on latest (or pass
--no-update), all earlier versions are reachable too — :n / :p step
between them.

By default each version is shown on its own page (less multi-file mode):
  :n / Space      next version
  :p              previous version
  ↑ ↓ PgUp PgDn   scroll within the current version
  g / G           jump to first / last line
  /pattern        search
  q               quit

Use --combined to flatten all versions into one scrollable buffer instead
(useful for cross-version search or piping to grep).

Options:
  -n, --no-update     skip `claude update`; show installed version + earlier
      --since VER     pin the CHANGELOG range lower bound (exclusive)
  -c, --combined      merge all versions into a single scrollable buffer
  -P, --no-pager      print everything plainly, no interactive pager
  -v, --version       print claude-update's own version and exit
  -h, --help          show this help

Short flags can be combined: -nP ≡ -n -P, -cnP ≡ -c -n -P.

Examples:
  claude-update                    # update and show what's new
  claude-update -n                 # show current version's CHANGELOG, no update
  claude-update -n --since 2.1.120 # show 2.1.120..current, no update
  claude-update --since 2.1.120    # update, then show 2.1.120..new

Pipe mode:
  When stdout is not a terminal, status lines and `claude update`
  progress are routed to stderr, and the section is emitted as raw
  Markdown (no ANSI, original `- ` bullets). The "browse earlier
  versions" broadening is suppressed too — pipe consumers can't
  navigate, and a 270KB dump rarely matches intent. Use --since to
  widen the range.

      claude-update -n | claude -p '翻译为简体中文'
      claude-update -n --since 2.1.120 | claude -p 'translate to JP'
      claude-update -n --since 2.1.120 > whats-new.md

Environment variables:
  CLAUDE_UPDATE_CHANGELOG_URL   override CHANGELOG source
  CLAUDE_UPDATE_PAGER / PAGER   pager command for --combined (default "less -RFX")
EOF
}

# Colors live above arg parsing because the unknown-arg error path uses $YELLOW.
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'
  GREEN=$'\033[0;32m'; CYAN=$'\033[0;36m'; YELLOW=$'\033[0;33m'; MAGENTA=$'\033[0;35m'
  RESET=$'\033[0m'
else
  BOLD=""; DIM=""; GREEN=""; CYAN=""; YELLOW=""; MAGENTA=""; RESET=""
fi

# fd3 = "chrome" channel: status lines, banners, `claude update` progress.
# When stdout is a TTY, fd3 → stdout so the user sees inline progress. When
# piped/redirected, fd3 → stderr so stdout stays pure Markdown for consumers
# like `claude-update -n | claude -p '翻译为中文'`.
if [[ -t 1 ]]; then
  exec 3>&1
else
  exec 3>&2
fi

NO_PAGER=0
COMBINED=0
NO_UPDATE=0
SINCE=""
arg_error() {
  printf '%sclaude-update: %s%s\n\n' "$YELLOW" "$*" "$RESET" >&2
  usage >&2
  exit 2
}

# Pre-expand combined short flags: -nc → -n -c, -cPn → -c -P -n. Long options
# (--xxx, --since=val) and unknowns containing digits/dashes (-n2.1.120) are
# left intact so the case loop handles them or rejects them as unknowns.
expanded_args=()
for _arg in "$@"; do
  if [[ "$_arg" =~ ^-[a-zA-Z]{2,}$ ]]; then
    for (( _i=1; _i<${#_arg}; _i++ )); do
      expanded_args+=("-${_arg:$_i:1}")
    done
  else
    expanded_args+=("$_arg")
  fi
done
set -- ${expanded_args[@]+"${expanded_args[@]}"}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -P|--no-pager)  NO_PAGER=1; shift ;;
    -c|--combined)  COMBINED=1; shift ;;
    -n|--no-update) NO_UPDATE=1; shift ;;
    --since)        [[ $# -ge 2 ]] || arg_error "--since requires a version (e.g. --since 2.1.120)"
                    SINCE="$2"; shift 2 ;;
    --since=*)      SINCE="${1#--since=}"; shift ;;
    -v|--version)   printf 'claude-update %s\n' "$CLAUDE_UPDATE_VERSION"; exit 0 ;;
    -h|--help)      usage; exit 0 ;;
    *)              arg_error "unknown argument: $1" ;;
  esac
done

die() { printf '%sclaude-update: %s%s\n' "$YELLOW" "$*" "$RESET" >&2; exit 1; }

if [[ -n "$SINCE" && ! "$SINCE" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
  die "--since expects a version like X.Y.Z, got: $SINCE"
fi

command -v claude >/dev/null 2>&1 || die "claude CLI not found; install Claude Code first"
command -v curl   >/dev/null 2>&1 || die "curl not found"

current_version() {
  claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true
}

# Prefetch CHANGELOG concurrently with `claude update`. Network on both sides usually
# overlaps, and we still know the upgrade outcome even if curl fails later.
changelog_tmp="$(mktemp -t claude-update-changelog.XXXXXX)"
trap 'rm -f "$changelog_tmp"' EXIT

curl -fsSL --max-time 15 "$CHANGELOG_URL" > "$changelog_tmp" 2>/dev/null &
fetch_pid=$!

old_version="$(current_version)"
printf '%scurrent version: %s%s%s\n' "$CYAN" "$BOLD" "${old_version:-not installed}" "$RESET" >&3

if [[ "$NO_UPDATE" == "1" ]]; then
  # View-only mode: skip `claude update`, but keep the background CHANGELOG fetch.
  new_version="$old_version"
else
  # Stream `claude update` to the chrome channel (stdout in TTY mode, stderr in pipe mode).
  printf '%s▶ running claude update ...%s\n' "$CYAN" "$RESET" >&3
  if ! claude update >&3; then
    kill "$fetch_pid" 2>/dev/null || true
    wait "$fetch_pid" 2>/dev/null || true
    die "claude update failed"
  fi

  new_version="$(current_version)"
  printf '%snew version:     %s%s%s\n' "$CYAN" "$BOLD" "${new_version:-unknown}" "$RESET" >&3
fi

if [[ -z "$new_version" ]]; then
  die "could not detect installed version; cannot determine CHANGELOG range"
fi

# Snapshot the pre-update version so we can tell apart "already on latest" from
# "first install" later — both leave $old_version in unhelpful shapes.
old_initial="$old_version"

# --since (if provided) pins the lower bound of the slice.
if [[ -n "$SINCE" ]]; then
  old_version="$SINCE"
fi

# Status line: only when we actually ran update and ended up at the same version.
# Drop the :n/:p hint in pipe mode — there's no pager to navigate, and the
# broadening that makes :n/:p useful is also suppressed below.
if [[ "$NO_UPDATE" == "0" && -z "$SINCE" && -n "$old_initial" && "$old_initial" == "$new_version" ]]; then
  if [[ -t 1 ]]; then
    printf '%s✓ already on latest; browse earlier versions with :n / :p%s\n' "$GREEN" "$RESET" >&3
  else
    printf '%s✓ already on latest%s\n' "$GREEN" "$RESET" >&3
  fi
fi

# Broadening rule: when the slice would otherwise contain only $new_version
# (already on latest, or --no-update without --since), drop the lower bound so
# :n / :p in the multi-file pager can step back through history. Suppress in
# pipe mode — the consumer can't navigate, and dumping the full ~270KB
# CHANGELOG to stdout rarely matches intent (`| claude -p '翻译'`, `> file.md`).
# --since explicitly opts out either way; first-install (old_initial empty) is
# handled below.
if [[ -z "$SINCE" && -n "$old_initial" && "$old_initial" == "$new_version" && -t 1 ]]; then
  old_version=""
fi

# First install: old_initial was empty. Limit the slice to just $new_version so
# the user isn't blasted with the entire CHANGELOG history on first install.
first_install=0
if [[ -z "$old_initial" ]]; then
  first_install=1
  old_version="$new_version"
fi

printf '%s▶ fetching CHANGELOG ...%s\n' "$CYAN" "$RESET" >&3
if ! wait "$fetch_pid"; then
  die "could not fetch CHANGELOG: $CHANGELOG_URL"
fi
changelog="$(cat "$changelog_tmp")"
[[ -n "$changelog" ]] || die "CHANGELOG is empty"

# Heads-up if the CHANGELOG contains prerelease tags; the slicer below treats them
# as their release version (e.g. 2.1.130-beta1 sorts the same as 2.1.130).
prerelease_seen="$(printf '%s\n' "$changelog" | awk '
  /^## / && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+-/ { print $2 }
')"
if [[ -n "$prerelease_seen" ]]; then
  printf '%snote: prerelease tags sorted by their release number: %s%s\n' \
    "$DIM" "$(echo "$prerelease_seen" | tr '\n' ' ')" "$RESET" >&2
fi

# Slice (old_version, new_version] using semver numeric comparison.
# Prereleases like X.Y.Z-beta1 are accepted: trailing non-digits in the patch are
# stripped before comparison. Headings that don't look like X.Y.Z* are ignored.
#
# Read the CHANGELOG straight from the temp file rather than `printf | awk`: real
# CHANGELOGs exceed the pipe buffer, and awk's early `exit` would close the pipe
# while printf is still writing, raising SIGPIPE → "broken pipe" → pipefail abort.
section="$(awk -v new="$new_version" -v old="$old_version" '
  function ver_num(v,    a, last) {
    if (split(v, a, ".") != 3) return -1
    last = a[3]
    sub(/[^0-9].*/, "", last)
    if (last == "") return -1
    return a[1]*1000000 + a[2]*1000 + last
  }
  BEGIN { new_n = ver_num(new); old_n = ver_num(old) }
  /^## / {
    n = ver_num($2)
    if (n < 0)            { next }
    if (n == new_n)       { printing = 1 }
    else if (n <= old_n)  { exit }
  }
  printing { print }
' "$changelog_tmp")"

# Use plain `-z`, not `${section// /}` — bash pattern substitution on the section
# is O(n^2) and the broadened slice can be the full CHANGELOG (~270KB → minutes).
# awk only emits lines copied from the source, so it never produces whitespace-only
# output that the looser check would have caught.
if [[ -z "$section" ]]; then
  printf '%sCHANGELOG has no entry for version %s%s\n' "$YELLOW" "$new_version" "$RESET" >&3
  exit 0
fi

if [[ "$first_install" == "1" ]]; then
  printf '%sfirst install: showing only %s%s\n' "$DIM" "$new_version" "$RESET" >&2
fi

# Highlight ## version headings (bold magenta) and "- " bullets (green).
# When colors are empty (non-TTY / piped), emit raw Markdown — keep `- ` bullets
# and skip the `• ` rewrite so pipe consumers (e.g. translators) see clean MD.
highlight() {
  awk -v BOLD="$BOLD" -v MAGENTA="$MAGENTA" -v GREEN="$GREEN" -v RESET="$RESET" '
    /^## / { printf "%s%s%s%s\n", BOLD, MAGENTA, $0, RESET; next }
    /^- / {
      if (GREEN != "") sub(/^- /, GREEN "• " RESET)
      print
      next
    }
    { print }
  '
}

want_interactive() {
  [[ "$NO_PAGER" == "0" && -t 1 ]]
}

if want_interactive && [[ "$COMBINED" == "0" ]] && command -v less >/dev/null 2>&1; then
  # Per-version browsing via less multi-file mode.
  tmpdir="$(mktemp -d -t claude-update.XXXXXX)"
  trap 'rm -f "$changelog_tmp"; rm -rf "$tmpdir"' EXIT

  # Split section into one file per version *and* apply highlighting in a single
  # awk pass — calling highlight() per-file forks awk N times (≈10s for 280
  # versions on macOS). Filenames are emitted on stdout in source order; less
  # iterates argv left-to-right, so no sort needed. while-read instead of
  # mapfile so the script runs on macOS bash 3.2.
  version_files=()
  while IFS= read -r f; do version_files+=("$f"); done < <(
    printf '%s\n' "$section" | awk -v dir="$tmpdir" -v BOLD="$BOLD" \
        -v MAGENTA="$MAGENTA" -v GREEN="$GREEN" -v RESET="$RESET" '
      /^## / {
        if (out) close(out)
        out = sprintf("%s/%s", dir, $2)
        print out
        printf "%s%s%s%s\n", BOLD, MAGENTA, $0, RESET > out
        next
      }
      out && /^- / {
        line = $0
        if (GREEN != "") sub(/^- /, GREEN "• " RESET, line)
        print line > out
        next
      }
      out { print > out }
    '
  )

  prompt="Claude Code %f   (%i/%m)   :n next  :p prev  q quit"
  less -R --prompt="$prompt" "${version_files[@]}"
else
  # --combined / --no-pager / non-TTY / no less: merge and optionally pipe to a pager.
  pager_cmd=""
  if want_interactive; then
    # PAGER / CLAUDE_UPDATE_PAGER come from the user's own environment, not untrusted
    # input; eval is used so users can pass quoted arguments (e.g. "less -Pmy prompt").
    pager_cmd="${CLAUDE_UPDATE_PAGER:-${PAGER:-less -RFX}}"
  fi
  # Banner is chrome — push to fd3 so pipe consumers don't see it before the
  # actual Markdown. In TTY mode fd3 → stdout so it still appears inline.
  printf '\n%s%s━━━ what'\''s new ━━━%s\n\n' "$BOLD" "$MAGENTA" "$RESET" >&3
  printf '%s\n' "$section" | highlight | if [[ -n "$pager_cmd" ]]; then eval "$pager_cmd"; else cat; fi
fi
